API_ID = 123456  # Replace with your actual API ID
API_HASH = your_api_hash_here  # Replace with your actual API HASH
BOT_TOKEN = 123456:ABCDEF1234567890  # Replace with your BOT_TOKEN
SESSION_STRING = your_session_string_here  # Replace with your SESSION_STRING

# Recommended safe defaults to avoid FloodWait
MAX_CONCURRENT_DOWNLOADS = 1
BATCH_SIZE = 500
FLOOD_WAIT_DELAY = 3

